{
  "surahs": [
    {
      "id": 1,
      "nameAr": "الفاتحة",
      "nameFa": "سوره حمد",
      "versesCount": 7,
      "type": "مکی",
      "juz": 1,
      "info": "سوره حمد؛ نخستین سوره قرآن کریم.",
      "ayahs": [
        {
          "n": 1,
          "ar": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",
          "fa": "به نام خداوند بخشنده مهربان"
        },
        {
          "n": 2,
          "ar": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",
          "fa": "ستایش مخصوص خداوند، پروردگار جهانیان است."
        },
        {
          "n": 3,
          "ar": "الرَّحْمَٰنِ الرَّحِيمِ",
          "fa": "بخشنده مهربان است."
        },
        {
          "n": 4,
          "ar": "مَالِكِ يَوْمِ الدِّينِ",
          "fa": "صاحب اختیار روز جزاست."
        },
        {
          "n": 5,
          "ar": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
          "fa": "تنها تو را می‌پرستیم و تنها از تو یاری می‌جوییم."
        },
        {
          "n": 6,
          "ar": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ",
          "fa": "ما را به راه راست هدایت کن."
        },
        {
          "n": 7,
          "ar": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ",
          "fa": "راه کسانی که به آنان نعمت دادی؛ نه راه کسانی که مورد خشم قرار گرفتند و نه گمراهان."
        }
      ]
    }
  ]
}